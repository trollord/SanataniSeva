# ── Database (Supabase Postgres) ────────────────────────────────────────────
# Both strings come from Supabase → Connect. Project ref: jbdtwgjvsqojcplhsfck
#
# DATABASE_URL — transaction pooler, port 6543. What the app runs on. Next.js is
# serverless, so every request would otherwise open its own connection and
# exhaust the pool. `pgbouncer=true` turns off named prepared statements, which
# transaction-mode pooling cannot support; `connection_limit=1` keeps each
# serverless instance to a single connection.
DATABASE_URL="postgresql://postgres.jbdtwgjvsqojcplhsfck:password@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#
# DIRECT_URL — session pooler, port 5432. Used only by `prisma migrate` /
# `db pull`, which need a real session. Prefer this over the direct
# db.<ref>.supabase.co host, which resolves to IPv6 only.
DIRECT_URL="postgresql://postgres.jbdtwgjvsqojcplhsfck:password@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Auth (NextAuth v5) ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32  (use the same value for both keys)
NEXTAUTH_SECRET="your-32-char-random-secret"
AUTH_SECRET="your-32-char-random-secret"
# Canonical origin, no trailing slash. http://localhost:3000 locally;
# https://sanataniseva.com in production. Everything absolute (metadata,
# sitemap, robots, emails) is derived from this.
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# ── Google OAuth (optional — enables "Continue with Google") ────────────────
# Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <base-url>/api/auth/callback/google
GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxx"

# ── Google Maps (optional — maps on listing pages) ──────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIzaSyXXXXXXXX"

# ── AWS S3 (optional — property image uploads) ──────────────────────────────
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="AKIAXXXXXXXX"
AWS_SECRET_ACCESS_KEY="xxxxxxxx"
AWS_S3_BUCKET_NAME="your-bucket-name"
NEXT_PUBLIC_AWS_S3_BUCKET_URL="https://your-bucket-name.s3.ap-south-1.amazonaws.com"

# ── Resend (required for emails: OTP verification, password reset, lead alerts)
# Dashboard: https://resend.com — verify your sending domain first
RESEND_API_KEY="re_xxxxxxxx"

# ── Razorpay (optional — advisory fee payments) ─────────────────────────────
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxx"
